{
    "name": "robertboes/skills-claim-checks",
    "description": "Verifies the version-specific claims made by the skills in this repository against the current framework and packages.",
    "license": "MIT",
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-csp": "^3.0",
        "spatie/laravel-package-tools": "^1.11"
    },
    "autoload-dev": {
        "psr-4": {
            "Skills\\ClaimChecks\\": "Claims/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
